{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Slackinux",
  "version": "0.1.0",
  "identifier": "com.slackinux.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "publisher": "Knownassa",
    "homepage": "https://github.com/Knownassa/Slackinux",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "category": "SocialNetworking",
    "shortDescription": "A lightweight Linux desktop shell for Slack Web",
    "icon": [
      "icons/icon.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
