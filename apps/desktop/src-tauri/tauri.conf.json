{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Slackinux",
  "version": "0.2.4",
  "identifier": "com.slackinux.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "createUpdaterArtifacts": true,
    "publisher": "Knownassa",
    "homepage": "https://github.com/Knownassa/Slackinux",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "category": "SocialNetworking",
    "shortDescription": "A lightweight Linux desktop shell for Slack Web",
    "icon": [
      "icons/icon.png",
      "icons/32x32@2x.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "desktopTemplate": "desktop.template"
      },
      "rpm": {
        "desktopTemplate": "desktop.template"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["slack"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2ODExNUI2QkI1RTBCRkUKUldUK0MxNjd0aFdCNWhQVFV1bFhEZlZmZ05IT3J6UzFnSmpHNk9icXRPWkZxZk1xTVBEM21YTEsK",
      "endpoints": [
        "https://github.com/Knownassa/Slackinux/releases/latest/download/latest.json"
      ]
    }
  }
}
